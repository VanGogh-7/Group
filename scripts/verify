#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

if [[ "${GROUP_VERIFY_OFFLINE:-0}" == "1" ]]; then
    export CARGO_NET_OFFLINE=true
fi

mode="${1:-fast}"

step() {
    printf '\n==> %s\n' "$1"
}

run_repository_checks() {
    step "git diff --check"
    git diff --check
}

run_fast() {
    run_repository_checks

    step "cargo fmt --all --check"
    cargo fmt --all --check

    step "cargo check --workspace --all-targets --all-features"
    cargo check --locked --workspace --all-targets --all-features
}

run_full() {
    run_repository_checks

    step "cargo fmt --all --check"
    cargo fmt --all --check

    step "strict workspace Clippy"
    cargo clippy --locked --workspace --all-targets --all-features -- -D warnings

    step "workspace tests"
    cargo test --locked --workspace

    step "Core doctests"
    cargo test --locked -p group-agent-core --doc

    step "Model doctests"
    cargo test --locked -p group-agent-model --doc

    step "Tool doctests"
    cargo test --locked -p group-agent-tool --doc

    step "Genai doctests"
    cargo test --locked -p group-agent-genai --doc

    step "MCP doctests"
    cargo test --locked -p group-agent-mcp --doc

    step "compile workspace benchmarks"
    cargo bench --locked --workspace --no-run

    step "all targets and features"
    cargo check --locked --workspace --all-targets --all-features
}

run_msrv() {
    step "Rust 1.85 foundation check"
    cargo +1.85.0 check --locked \
        --workspace \
        --exclude group-agent-genai \
        --exclude group-agent-mcp \
        --all-targets \
        --all-features

    step "Rust 1.85 foundation tests"
    cargo +1.85.0 test --locked \
        --workspace \
        --exclude group-agent-genai \
        --exclude group-agent-mcp

    step "Rust 1.88 Genai check"
    cargo +1.88.0 check --locked \
        -p group-agent-genai \
        --all-targets \
        --all-features

    step "Rust 1.88 Genai tests"
    cargo +1.88.0 test --locked -p group-agent-genai

    step "Rust 1.88 Genai doctests"
    cargo +1.88.0 test --locked -p group-agent-genai --doc

    step "Rust 1.88 MCP check"
    cargo +1.88.0 check --locked \
        -p group-agent-mcp \
        --all-targets \
        --all-features

    step "Rust 1.88 MCP tests"
    cargo +1.88.0 test --locked -p group-agent-mcp

    step "Rust 1.88 MCP doctests"
    cargo +1.88.0 test --locked -p group-agent-mcp --doc
}

case "$mode" in
    fast)
        run_fast
        ;;
    full)
        run_full
        ;;
    msrv)
        run_msrv
        ;;
    all)
        run_full
        run_msrv
        ;;
    *)
        printf 'usage: %s {fast|full|msrv|all}\n' "$0" >&2
        printf '%s\n' \
            'Cargo may fetch dependencies fixed by Cargo.lock when caches are missing.' \
            'Set GROUP_VERIFY_OFFLINE=1 to force Cargo offline with no network fallback.' \
            'Verification never contacts live Model Providers, MCP Servers, or external test services.' >&2
        exit 2
        ;;
esac

step "verification mode '$mode' passed"
